APP_NAME=CivicLens
APP_ENV=local
AUTH_PROVIDER=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
RESET_TTL_SECONDS=900
# JSON/control API bodies are bounded before parsing; uploads retain their separate 3.25MiB cap.
MAX_API_REQUEST_BYTES=65536
# LOCAL_DB_PATH defaults to backend/data/civiclens_local.db
# LOCAL_EVIDENCE_ROOT defaults to a private evidence/ directory beside LOCAL_DB_PATH.
# Local mode selects COMPLAINT_PROVIDER=sqlite and EVIDENCE_PROVIDER=local.
# AWS mode selects COMPLAINT_PROVIDER=dynamodb and EVIDENCE_PROVIDER=s3; no fallback.
COMPLAINT_RATE_LIMIT=10
COMPLAINT_RATE_WINDOW=900
COMPLAINT_DESCRIPTION_MAX=2000
PUBLIC_QUERY_RATE_LIMIT=120
DISCOVERY_CANDIDATE_LIMIT=2000
NEARBY_MAX_RADIUS_METERS=200000
# Enable in cloud ONLY after verified complete regional projection bootstrap/backfill.
CLOUD_DISCOVERY_REGIONS_READY=false
CLOUD_OWNER_QUERY_LIMIT=5000
# Experimental Phase 6 matching. Worker runs only in APP_ENV=local, not Lambda/test fixtures.
MATCHING_WORKER_ENABLED=true
MATCHING_CANDIDATE_LIMIT=100
MATCHING_JOB_SECONDS=8
MATCHING_RADIUS_METERS=50
MATCHING_STREETLIGHT_RADIUS=30
MATCHING_POTHOLE_RADIUS=50
MATCHING_ROAD_RADIUS=75
MATCHING_DRAINAGE_RADIUS=75
MATCHING_STRONG_THRESHOLD=0.80
MATCHING_REVIEW_THRESHOLD=0.60
# Phase 7: safe default. Auto mode is experimental and has measured false positives.
CLUSTERING_MODE=REVIEW_ONLY
CLUSTERING_AUTO_THRESHOLD=0.90
CLUSTERING_AUTO_SPAN_METERS=10
CLUSTERING_MANUAL_SPAN_METERS=75
CLUSTERING_MAX_MEMBERS=30
CLUSTERING_TARGET_LIMIT=5
CLUSTERING_REQUIRE_IMAGES=true
# Phase 8: experimental administrative urgency rubric, never a probability or dispatch service.
PRIORITY_WEIGHTS=[0.40,0.25,0.20,0.15]
PRIORITY_BANDS=[40,60,80]
PRIORITY_REPORTER_SATURATION=30
PRIORITY_AGING_DAYS=30
PRIORITY_REFRESH_SECONDS=3600
ASSIGNMENT_MODE=MANUAL_APPROVAL
WORKLOAD_WEIGHTS=[1,2,3,4]
# Fixed upper bounds: 2 images, 1572864 bytes each, 3407872 request bytes,
# 4000000 pixels, 4096px per dimension; sanitized JPEG output at most 2048px.
# APP_ENV=aws requires AUTH_PROVIDER=cognito, DEBUG=false, and these references:
# COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# COGNITO_CLIENT_ID=APP_CLIENT_ID
# COGNITO_DOMAIN=https://PREFIX.auth.REGION.amazoncognito.com
# COGNITO_API_SCOPE=civiclens/access

# Cloud references are injected by CDK later; leave unset for local development.
# COMPLAINTS_TABLE_NAME=
# INCIDENTS_TABLE_NAME=
# AUDIT_EVENTS_TABLE_NAME=
# EVIDENCE_BUCKET_NAME=
# WORKFLOW_TABLE_NAME=
# EVENT_BUS_NAME=
# TRIAGE_STATE_MACHINE_ARN=
# OPERATIONAL_ALERT_TOPIC_ARN=
# SNS is a prepared operational adapter, never automatic citizen email delivery.
OPERATIONAL_ALERTS_ENABLED=false
# Phase11: explicit IANA municipality zone; tzdata is installed for native Windows.
ANALYTICS_TIMEZONE=UTC
ANALYTICS_SCOPE=municipality
ANALYTICS_MAX_INCIDENTS=5000
ANALYTICS_MAX_COMPLAINTS=10000
# Optional named municipal boundaries: JSON map of south,west,north,east rectangles.
ANALYTICS_SERVICE_AREAS={}

