VITE_APP_NAME=CivicLens
VITE_API_BASE_URL=/api
VITE_AUTH_MODE=local
# Optional SAME-ORIGIN place-search adapter; no default external geocoder.
# VITE_LOCATION_SEARCH_URL=/api/operator-managed-location-search
# Endpoint must return {"results":[{"label":"Place","latitude":0,"longitude":0}]}.
# The operator must supply this endpoint and enforce provider-wide limits/identification/cache.
# AWS mode requires all public values below; no client secret is used.
# VITE_COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# VITE_COGNITO_CLIENT_ID=APP_CLIENT_ID
# VITE_COGNITO_DOMAIN=https://PREFIX.auth.REGION.amazoncognito.com
# VITE_COGNITO_REDIRECT_URI=https://FRONTEND/auth/callback
# VITE_COGNITO_LOGOUT_URI=https://FRONTEND/

